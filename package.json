{
  "name": "faqs-microservice",
  "version": "1.0.0",
  "description": "get closed answers to each question",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prettier": "npx prettier --write .",
    "lint": "eslint . --fix",
    "lint:fix": "npm run prettier && npm run lint",
    "build": "tsc",
    "serve": "tsc-watch --onSuccess \"node dist/index.js\"",
    "start": "npm run build && npm run serve",
    "start:prod": "npm run build && node dist/index.js"
  },
  "author": {
    "name": "Joaquin Gonzalez Budino",
    "email": "joa_gzb@hotmail.com",
    "github": "https://github.com/joagzb",
    "linkedin": "http://linkedin.com/in/joaquin-gonzalez-budino"
  },
  "license": "MIT",
  "keywords": [
    "question",
    "answer",
    "text",
    "search"
  ],
  "dependencies": {
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-winston": "^4.2.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.1.14",
    "typeorm": "^0.3.25",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.121",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.10.2",
    "prettier": "2.7.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsc-watch": "^5.0.3",
    "typescript": "^4.9.5"
  }
}
